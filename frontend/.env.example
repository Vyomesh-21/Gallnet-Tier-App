# GallNet Triage - Frontend Environment Configuration
# Production URL of the GallNet FastAPI backend on Render
# Example: https://gallnet-backend.onrender.com
#
# Note: For local development with Vite dev server (npm run dev),
# leave VITE_API_URL empty or unset to automatically use the Vite proxy (http://127.0.0.1:8000).
VITE_API_URL=https://gallnet-backend.onrender.com

